# =============================================================================
# SkillBridge Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Convention: Vite exposes only variables prefixed with VITE_ to the browser.
# =============================================================================

# URL of the deployed SkillBridge backend (no trailing slash).
# Local development:
#   VITE_API_URL=http://localhost:8000
# Production (Render):
#   VITE_API_URL=https://<your-service-name>.onrender.com
VITE_API_URL=
