# Docker-local backend settings
DATABASE_URL=sqlite:////app/db/skillbridge.db
REDIS_URL=redis://redis:6379/0

# Choose one LLM provider: ollama or groq
#
# Option A: Local Ollama (free, runs on your machine)
# 1. Install Ollama: https://ollama.com/download
# 2. Pull a model: ollama pull mistral
# 3. Keep Ollama running while Docker Compose is up.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# Option B: Groq API (hosted, faster, requires an API key)
# 1. Create a key at https://console.groq.com/keys
# 2. Set LLM_PROVIDER=groq
# 3. Uncomment and fill the values below.
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# LLM latency controls
LLM_TIMEOUT_SECONDS=20
LLM_PARSE_TIMEOUT_SECONDS=8
FAST_PARSE_MIN_SKILLS=3

# Matching and app settings
EMBEDDING_DIMENSIONS=384
SIMILARITY_THRESHOLD=0.62
DEBUG=false
SECRET_KEY=change-this-for-production
